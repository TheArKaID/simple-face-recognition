# Test fixtures are real employee faces.  COPY . . was baking 60MB of them into
# an image the CI workflow pushes to Docker Hub, which is a data-protection
# problem before it is a size one.  tests/ is mounted when the suites need it:
#   docker run -v "$PWD/tests:/app/tests" ...
tests/
.git/
.github/
.gitignore
.dockerignore

# Regenerated by tools/convert_minifas.py and fetched by the build; never needed
# from the build context.
models/arcface/

# Local development leftovers
data/
*.db
*.db-wal
*.db-shm
__pycache__/
*.pyc
clean_requirements.txt
used_requirements.txt
